e widget always answers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#6B7280;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1400" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 · Data model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Data model: request, stream, knowledge, UI state" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#0E1013;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="req" value="ChatRequest" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#E9EEF7;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;html=1;strokeColor=#2A5DA8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0E1013;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="118" as="geometry"/></mxCell><mxCell id="req_r0" value="sessionId: string  (uuid, per tab)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#41485A;html=1;whiteSpace=wrap;" vertex="1" parent="req"><mxGeometry x="0" y="30" width="300" height="22" as="geometry"/></mxCell><mxCell id="req_r1" value="locale: 'en' | 'fr'" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Helvetica;fontSize=11;fontColor=#41485A;html=1;whiteSpace=wrap;" vertex="1" parent="req"><mxGeometry x="0" y="52" width="300" height="22" as="geometry"/></mxCell><mxCell id="req_r2" value="messages: ChatTurn[]  (last 6)" style="text;strokeColor=none;fil